        "panel-3": {
            "kind": "Panel",
            "spec": {
                "data": {
                    "kind": "QueryGroup",
                    "spec": {
                        "queries": [
                            {
                                "kind": "PanelQuery",
                                "spec": {
                                    "hidden": false,
                                    "query": {
                                        "datasource": {
                                            "name": "influxdb"
                                        },
                                        "group": "influxdb",
                                        "kind": "DataQuery",
                                        "spec": {
                                            "query": "from(bucket: \"power_monitoring\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> map(fn: (r) => ({\n    r with\n    identifier: if exists r.identifier then r.identifier else r.machine\n}))\n  |> group(columns: [\"_measurement\",\"identifier\"])\n  |> last()\n  |> group()\n  |> keep (columns: [\"identifier\",\"_time\",\"_value\"])\n  |> group(columns:[\"identifier\"])\n  |> last()\n  |> group()\n  |> keep (columns: [\"identifier\",\"_time\"])\n"
                                        },
                                        "version": "v0"
                                    },
                                    "refId": "A"
                                }
                            }
                        ],
                        "queryOptions": {},
                        "transformations": [
                            {
                                "group": "organize",
                                "kind": "Transformation",
                                "spec": {
                                    "options": {
                                        "excludeByName": {},
                                        "includeByName": {},
                                        "indexByName": {
                                            "_time": 1,
                                            "identifier": 0
                                        },
                                        "renameByName": {}
                                    }
                                }
                            },
                            {
                                "group": "sortBy",
                                "kind": "Transformation",
                                "spec": {
                                    "options": {
                                        "fields": {},
                                        "sort": [
                                            {
                                                "field": "_time"
                                            }
                                        ]
                                    }
                                }
